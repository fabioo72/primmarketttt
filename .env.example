# === Supabase ===
# Project URL (safe to be public). Either name works.
NEXT_PUBLIC_SUPABASE_URL=https://lounglriuipdgphhsohn.supabase.co
# SUPABASE_URL=

# Service-role key — SERVER ONLY. Do NOT prefix with NEXT_PUBLIC_.
# Get it from Supabase → Project settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# === Admin panel ===
# Bearer token for /api/admin/* and admin.html. Long random string of your choice.
ADMIN_TOKEN=

# === Receive wallets ===
BTC_ADDRESS=
LTC_ADDRESS=
# ETH_ADDRESS is also used for USDT and USDC (ERC-20)
ETH_ADDRESS=

# === Etherscan ===
# Free API key from https://etherscan.io/apis — required for ETH/USDT/USDC detection.
ETHERSCAN_API_KEY=

# === ERC-20 contract overrides (optional) ===
# USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
# USDC_CONTRACT=
